<Window x:Class="Marketplace.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Marketplace" Style="{StaticResource Windows}"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Grid HorizontalAlignment="Left" 
              Grid.Row="0"
              Name="AdminPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition  />
                <ColumnDefinition  />
                <ColumnDefinition  />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="20 0" Grid.Column="0">
                <TextBlock Text="Поиск" Margin="0 0 0 5"/>
                <TextBox Name="SearchTextBox" 
                         Width="200" 
                         Height="30"
                         TextChanged="SearchTextBox_TextChanged"/> 
            </StackPanel>
            <StackPanel Margin="20 0" Grid.Column="1">
                <TextBlock Text="Сортировка" Margin="0 0 0 5"/>
                <ComboBox 
                    Name="SortingComboBox" 
                    Width="200"
                    SelectionChanged="SortingComboBox_SelectionChanged"/>
            </StackPanel>
            <StackPanel Margin="20 0" 
                        Grid.Column="2">
                <TextBlock 
                    Text="Фильтрация" 
                    Margin="0 0 0 5"/>
                <ComboBox 
                    Name="FilterComboBox" 
                    Width="200"
                    SelectionChanged="FilterComboBox_SelectionChanged"/>
            </StackPanel>
        </Grid>
        
        <TextBlock
                    Name="FullUserName"
                    FontWeight="Bold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="10"
            />

        <ScrollViewer Grid.Row="1">
            <ItemsControl Name="ProductList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" 
                                Tag="{Binding Id}"
                                MouseDown="Border_MouseDown"
                                Background="{Binding Background}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border 
                                    Grid.Column="0" 
                                    Width="80" 
                                    Height="80"
                                    
                                    Margin="15 0"
                                >
                                    <Image Source="{Binding ImagePath}" />

                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock 
                                        FontWeight="SemiBold">
                                        <Run Text="{Binding Category.Name}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Provider.Name}" />
                                    <TextBlock Text="{Binding Producer.Name}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Цена: " />
                                        <TextBlock Text="{Binding Price, StringFormat=C2}" />
                                        <TextBlock Text="   " />
                                        <TextBlock Text="{Binding OldPrice, StringFormat=C2}" Foreground="Red" TextDecorations="Strikethrough"/>
                                    </StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding AmountIntStock}" />
                                        <Run Text="{Binding Unit.Name}" />
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Margin="0 0 10 0">
                                        <Run Text="{Binding Discount}" />
                                        <Run Text="%" />
                                    </TextBlock>
                                </Border>
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <Button
            Name="LogOutButton"
            Content="Выйти"
            Padding="5"
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="10"
            Click="LogOutButton_Click"
            />

        <Button
            Name="CreateButton"
            Content="Создать"
            Padding="5"
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="10"
            Visibility="Collapsed"
            Click="CreateButton_Click"
            />  





    </Grid>
</Window>
