<Window x:Class="Marketplace.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Marketplace"
        mc:Ignorable="d" Style="{StaticResource Windows}"
        Title="Редактирование данные о продукта" Height="750" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel Margin="10" VerticalAlignment="Center">
                <TextBlock Text="Артикул" />
                <TextBox x:Name="ProductArticle"
                         MaxLength="10" />

                <TextBlock Text="Наименование" />
                <TextBox x:Name="ProductTitle"
                        MaxLength="30" />
                <TextBlock Text="Единица измерения" />
                <ComboBox x:Name="ProductUnit"
                            />
                <TextBlock Text="Цена" />
                <TextBox Name="ProductPrice" />
                <TextBlock Text="Производитель" />
                <ComboBox x:Name="ProductProducer"
                            />
                <TextBlock Text="Поставщик" />
                <ComboBox x:Name="ProductProvider"
                            />
                <TextBlock Text="Категория" />
                <ComboBox x:Name="ProductCategory"
                            />
                <TextBlock Text="Скидка" />
                <TextBox Name="Discount" />

                <TextBlock Text="Количество на складе" />
                <TextBox Name="ProductAmountInStock" />

                <TextBlock Text="Описание" />
                <TextBox Name="ProductDescription" 
                         Height="100"
                         TextWrapping="Wrap"/>

                <TextBlock Text="Путь к изображению" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Name="ProductPhoto" Width="600" VerticalAlignment="Center"  HorizontalAlignment="Left"/>
                    <Button Name="ChooseImage"
                            Content="Выбрать"
                            Click="ChooseImage_Click"
                            HorizontalAlignment="Right"/>
                </StackPanel>
                
                


            </StackPanel>

            
        </ScrollViewer>
        <Button Name="CancelButton"
            Content="Отменить"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Margin="20 0"
            VerticalAlignment="Center"
            Click="CancelButton_Click"
            />

        <Button Name="SaveButton"
            Content="Сохранить"
            Grid.Row="1"
            Margin="20 0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Click="SaveButton_Click"
            />
    </Grid>
</Window>
